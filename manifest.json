{
  "action": {
    "default_popup": "popup.html",
    "default_title": "BlinkScroll"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "js": [
        "src/site-routing.js",
        "content.js"
      ],
      "matches": [
        "*://instagram.com/*",
        "*://www.instagram.com/*",
        "*://tiktok.com/*",
        "*://www.tiktok.com/*",
        "*://youtube.com/*",
        "*://www.youtube.com/*",
        "*://facebook.com/*",
        "*://www.facebook.com/*",
        "*://m.facebook.com/*"
      ],
      "run_at": "document_idle"
    }
  ],
  "description": "Scroll reels & shorts with your blinks. Hands-free, 100% on-device \u2014 no video ever leaves your laptop.",
  "host_permissions": [
    "*://instagram.com/*",
    "*://www.instagram.com/*",
    "*://tiktok.com/*",
    "*://www.tiktok.com/*",
    "*://youtube.com/*",
    "*://www.youtube.com/*",
    "*://facebook.com/*",
    "*://www.facebook.com/*",
    "*://m.facebook.com/*"
  ],
  "icons": {
    "128": "icons/icon128.png",
    "16": "icons/icon16.png",
    "48": "icons/icon48.png"
  },
  "manifest_version": 3,
  "name": "BlinkScroll",
  "key": "",
  "permissions": [
    "storage",
    "offscreen",
    "tabs",
    "scripting"
  ],
  "version": "0.2.9",
  "sandbox": {
    "pages": [
      "sandbox/detect.html"
    ]
  }
}